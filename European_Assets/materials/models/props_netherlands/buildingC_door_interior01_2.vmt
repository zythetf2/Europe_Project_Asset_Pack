VertexLitGeneric
{
	$basetexture "models/props_netherlands/buildingC_door_interior01_2"
	$bumpmap "models/props_netherlands/buildingC_door_interior01_normal"

 $normalmapalphaenvmapmask 1 // use the alpha channel of normal map as specular map
"$envmap" "env_cubemap"
 $envmapsaturation 0.5
 $envmapcontrast 1
 $envmaptint "[0.4 0.4 0.4]"

 $surfaceprop wood // physics type
}