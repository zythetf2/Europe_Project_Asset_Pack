LightmappedGeneric
{
 $basetexture "netherlands/rooftile_corrugated003" // diffuse map
 
 $bumpmap "netherlands/rooftile_corrugated_normal_withered1" // normal map
 
 $normalmapalphaenvmapmask 1 // use the alpha channel of normal map as specular map
"$envmap" "env_cubemap"
 $envmapsaturation 0.5
 $envmapcontrast 1
 $envmaptint "[0.3 0.3 0.3]"

 $surfaceprop tile // physics type
"%keywords" "tf"
}