LightmappedGeneric
{
 $basetexture "netherlands/plasterwall_tiling001" // diffuse map
 
 $bumpmap "netherlands/plasterwall_tiling_normal" // normal map
 
 $normalmapalphaenvmapmask 1 // use the alpha channel of normal map as specular map
"$envmap" "env_cubemap"
 $envmapsaturation 0.5
 $envmapcontrast 1
 $envmaptint "[0.5 0.5 0.5]"

 $surfaceprop brick// physics type
"%keywords" "tf"
}